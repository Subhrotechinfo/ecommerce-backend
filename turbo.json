{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    }
  },
  "globalDependencies": [
    ".env",
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "AUTH_SERVICE_APP_PORT",
    "AUTH_SERVICE_APP_NAME",
    "PRODUCT_SERVICE_APP_PORT",
    "PRODUCT_SERVICE_APP_NAME",
    "MONGODB_URI",
    "JWT_EXPIRES_IN",
    "JWT_SECRET"
  ],
  "futureFlags": {
    "pruneIncludesGlobalFiles": true
  }
}