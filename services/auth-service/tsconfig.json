{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../services/auth-service/dist",
    "rootDir": "./src",
    // --- NestJS decorator support ---
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    // --- Output ---
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    // "incremental" → REMOVED (redundant with composite)
    // --- Strictness (kept relaxed for NestJS compatibility) ---
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "forceConsistentCasingInFileNames": true,
    // --- Re-declare lib paths relative to THIS tsconfig ---
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@libs/common": [
        "../../libs/common/src/index.ts"
      ],
      "@libs/common/*": [
        "../../libs/common/src/*"
      ],
      "@libs/core": [
        "../../libs/core/src/index.ts"
      ],
      "@libs/core/*": [
        "../../libs/core/src/*"
      ],
    }
  },
  "include": [
    "./src/**/*"
  ],
  "references": [
    {
      "path": "../../libs/common"
    },
    {
      "path": "../../libs/core"
    }
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}