{
    "compilerOptions": {
        // --- Module system ---
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ESNext",
        // --- TS6 new/changed flags ---
        "erasableSyntaxOnly": false,
        "noUncheckedSideEffectImports": true,
        // --- Project references (Turborepo) ---
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        // --- Interop ---
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        // --- Quality ---
        "skipLibCheck": true,
        "strict": false,
        "noImplicitAny": false,
        // --- Path aliases (libs) ---
        "paths": {
            "@libs/common": [
                "./libs/common/src/index.ts"
            ],
            "@libs/common/*": [
                "./libs/common/src/*"
            ],
            "@libs/core": [
                "./libs/core/src/index.ts"
            ],
            "@libs/core/*": [
                "./libs/core/src/*"
            ]
        }
    },
    "ts-node": {
        "require": [
            "tsconfig-paths/register"
        ]
    }
}